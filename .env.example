# Настройки Причала. install.sh копирует этот файл в .env; права 600.

# Порт на сервере. Панель слушает только 127.0.0.1, заходить через SSH-туннель.
PRICHAL_PORT=9443

# Подпись сервера на «Обзоре» и в заголовке вкладки браузера. Пусто: имя хоста.
LABEL=

# Пароль для входа. Можно оставить пустым: тогда при первом входе через
# SSH-туннель панель попросит его придумать и сохранит у себя (только хэш).
# Пароль, заданный здесь, главнее придуманного. Обязателен, если открыть порт
# наружу или поставить панель за обратный прокси.
PRICHAL_PASSWORD=

# Доменные имена, по которым открывают панель через обратный прокси, через запятую.
# Например: panel.example.com
ALLOWED_HOSTS=

# Уведомления в Telegram: токен бота от @BotFather и ваш @username (без @).
# Бот будет писать только этому человеку, после того как он нажмёт Start.
# Проще подключить бота прямо в панели: Обзор → Уведомления → Подключить.
# Настройки из панели главнее этих строк.
TG_TOKEN=
TG_USERNAME=

# Часовой пояс для сообщений и воскресной сводки обновлений (12:00).
# Пусто: московское время.
TZ=

# ---- Прокси Telegram (по желанию) ----
# PROXY=1 — ./install.sh поставит прокси Telegram (telemt) рядом с Причалом и включит его
# в обновления Причала. Ссылки и секреты потом создаются и меняются в панели:
# Подключения → Прокси Telegram.
PROXY=
# Порт на сервере, к которому подключается Telegram, и адрес, на котором его слушать.
# Если 443 уже занят (например, nginx), поставьте свободный порт и PROXY_BIND=127.0.0.1,
# а снаружи отдайте его через nginx; тогда PROXY_PUBLIC_PORT=443.
PROXY_PORT=443
PROXY_BIND=0.0.0.0
# Адрес и порт в ссылках tg://proxy. Пусто: внешний IP сервера и PROXY_PORT.
PROXY_PUBLIC_HOST=
PROXY_PUBLIC_PORT=
# Сайт-маскировка: на него прокси отправляет всех, кто подключился без секрета.
# Нужен настоящий сайт с HTTPS, например, ya.ru.
PROXY_TLS_DOMAIN=
# Перенести ссылки (секреты, лимиты, сайт-маскировку) из уже работающего прокси Amnezia:
# имя его контейнера, обычно amnezia-telemt. Ссылки у людей не изменятся, если совпадут
# PROXY_PUBLIC_HOST и PROXY_PUBLIC_PORT.
PROXY_IMPORT=
# Заполняет install.sh: пароль API прокси (знают только Причал и прокси) и подсеть их
# закрытой сети. Менять подсеть, только если она занята на сервере.
PROXY_API_TOKEN=
PROXY_API_SUBNET=172.30.207.0/28
