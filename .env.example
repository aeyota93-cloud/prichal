# Настройки Причала. install.sh копирует этот файл в .env; права 600.

# Порт на сервере. Панель слушает только 127.0.0.1, заходить через SSH-туннель.
PRICHAL_PORT=9443

# Подпись сервера на «Обзоре» и в заголовке вкладки браузера. Пусто: имя хоста.
LABEL=

# Пароль для входа. Можно оставить пустым: тогда при первом входе через
# SSH-туннель панель попросит его придумать и сохранит у себя (только хэш).
# Пароль, заданный здесь, главнее придуманного. Обязателен, если открыть порт
# наружу или поставить панель за обратный прокси.
PRICHAL_PASSWORD=

# Доменные имена, по которым открывают панель через обратный прокси, через запятую.
# Например: panel.example.com
ALLOWED_HOSTS=

# Уведомления в Telegram: токен бота от @BotFather и ваш @username (без @).
# Бот будет писать только этому человеку, после того как он нажмёт Start.
# Проще подключить бота прямо в панели: Обзор → Уведомления → Подключить.
# Настройки из панели главнее этих строк.
TG_TOKEN=
TG_USERNAME=

# Часовой пояс для сообщений и воскресной сводки обновлений (12:00).
# Пусто: московское время.
TZ=
