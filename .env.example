# Настройки Причала. install.sh копирует этот файл в .env; права 600.

# Порт на сервере. Панель слушает только 127.0.0.1, заходить через SSH-туннель.
PRICHAL_PORT=9443

# Подпись сервера в шапке. Пусто: имя хоста.
LABEL=

# Пароль для входа. Необязателен, пока панель доступна только через туннель.
# Обязателен, если открыть порт наружу или поставить панель за обратный прокси.
PRICHAL_PASSWORD=

# Доменные имена, по которым открывают панель через обратный прокси, через запятую.
# Например: panel.example.com
ALLOWED_HOSTS=

# Уведомления в Telegram: токен бота от @BotFather и ваш @username (без @).
# Бот будет писать только этому человеку, после того как он нажмёт Start.
TG_TOKEN=
TG_USERNAME=
